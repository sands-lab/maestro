LAB_DESCRIPTION="Content Creation with 3 Dhained ADK Agents"
LAB_VERSION=1.0
LAB_AUTHOR="Yixi Chen"
LAB_EMAIL=yixi.chen@kaust.edu.sa
LAB_WEB=https://www.kathara.org/

r1[0]="A/00:00:00:00:00:a1"
r1[1]="C/00:00:00:00:00:c1"
r1[image]="kathara/base"
r1[ipv6]="false"

r2[0]="B/00:00:00:00:00:b1"
r2[1]="C/00:00:00:00:00:c2"
r2[image]="kathara/base"
r2[ipv6]="false"

planner[0]="A/00:00:00:00:00:01"
planner[image]="a2a/content_planner"
planner[bridged]=true
planner[ipv6]="false"
planner[env]="GOOGLE_API_KEY=$GOOGLE_API_KEY"

writer[0]="A/00:00:00:00:00:02"
writer[image]="a2a/content_writer"
writer[bridged]=true
writer[ipv6]="false"
writer[env]="GOOGLE_API_KEY=$GOOGLE_API_KEY"

editor[0]="A/00:00:00:00:00:03"
editor[image]="a2a/content_editor"
editor[bridged]=true
editor[ipv6]="false"
editor[env]="GOOGLE_API_KEY=$GOOGLE_API_KEY"

creation_agent[0]="B/00:00:00:00:00:04"
creation_agent[image]="a2a/content_creation"
creation_agent[bridged]=true
creation_agent[port]="8083:8083"
creation_agent[ipv6]="false"
creation_agent[env]="CONTENT_PLANNER_AGENT_URL=http://200.1.1.3:10001"
creation_agent[env]="CONTENT_WRITER_AGENT_URL=http://200.1.1.5:10002"
creation_agent[env]="CONTENT_EDITOR_AGENT_URL=http://200.1.1.7:10003"
creation_agent[env]="GOOGLE_API_KEY=$GOOGLE_API_KEY"
