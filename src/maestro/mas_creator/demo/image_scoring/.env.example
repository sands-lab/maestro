# ============================================================
# Image-Scoring mas_creator demo — environment configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ---- OpenAI API key (required) ----
# Used for agents (gpt-4o-mini), vision scoring (gpt-4o), and image generation (dall-e-3).
OPENAI_API_KEY=your-openai-api-key-here

# ---- Model configuration ----
# IMAGE_GEN_MODEL: DALL-E model used for image generation
IMAGE_GEN_MODEL=dall-e-3
# VISION_MODEL: GPT model used inside score_image_against_policy() for visual scoring
VISION_MODEL=gpt-4o

# ---- Pipeline tuning ----
# Stop when total_score > SCORE_THRESHOLD (max possible score is 50)
SCORE_THRESHOLD=45
# Hard cap on retry iterations regardless of score
MAX_ITERATIONS=3
